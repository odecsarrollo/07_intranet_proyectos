# Copiar a .env y ajustar valores. No commitear .env (contiene secretos).
DJANGO_CONFIGURATION=OnPrem
DJANGO_SETTINGS_MODULE=intranet_proyectos.settings
DJANGO_SECRET_KEY=cambiar-por-un-secreto-largo
ALLOWED_HOSTS=proyectos.odecopack.co,www.proyectos.odecopack.co,190.85.248.102,10.75.45.4,localhost,127.0.0.1

DB_ENGINE=django.db.backends.mysql
DB_NAME=proyectos_intranet
DB_USER=proyectos
DB_PASSWORD=cambiar
DB_ROOT_PASSWORD=cambiar
DB_HOST=db
DB_PORT=3306
DB_HOST_REPLICA=db

CELERY_BROKER_URL=redis://redis:6379/0

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
SERVER_EMAIL=webmaster@example.com
DEFAULT_FROM_EMAIL=webmaster@example.com
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True

# Podman: rutas dentro del contenedor (bind mount ./media → /app/media)
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
