option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: intranet_proyectos.settings
    DJANGO_CONFIGURATION: Production
    # Variables de entorno para mysqlclient (fallback si pkg-config no funciona)
    MYSQLCLIENT_CFLAGS: "-I/usr/include/mysql"
    MYSQLCLIENT_LDFLAGS: "-L/usr/lib64/mysql -lmysqlclient"
  aws:elasticbeanstalk:container:python:
    # WSGIPath debe usar notación de módulo Python (puntos, no slashes)
    # Formato: module.path:variable_name
    WSGIPath: "intranet_proyectos.wsgi:application"