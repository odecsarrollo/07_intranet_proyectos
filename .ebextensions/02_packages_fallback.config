commands:
  01_install_python_dev_fallback:
    command: "yum install -y python3-devel || yum install -y python36-devel || yum install -y python3.6-devel || echo 'Python dev package installation attempted'"
    ignoreErrors: true
  02_verify_python_dev:
    command: "rpm -qa | grep -i python.*devel || echo 'Warning: Python dev package may not be installed'"
    ignoreErrors: true

